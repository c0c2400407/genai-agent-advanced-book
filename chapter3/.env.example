# LM Studio OpenAI-compatible local server
# Default LM Studio server address; change only if the port differs.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Leave blank to auto-select the first model available from /v1/models.
LMSTUDIO_MODEL=
# LM Studio does not require a key by default. Keep this placeholder unless authentication is enabled.
LMSTUDIO_API_KEY=lm-studio

# Tavily API setting (required only for the web-search example)
TAVILY_API_KEY=

# PostgreSQL settings (Text-to-SQL example)
PGUSER=testuser
PGPASSWORD=testpass
PGHOST=localhost
PGDATABASE=testdb
PGPORT=5432

