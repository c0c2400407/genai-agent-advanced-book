LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
# LM Studioで既にロードしている1モデルのIDを指定する
# /v1/modelsには未ロードのモデルも含まれるので注意
LLM_MODEL=qwen3.5-4b-abliterated-i1
STRUCTURED_MODE=schema
TOOL_MODE=native
REASONING_EFFORT=none
MAX_OUTPUT_TOKENS=1200
# 最初は1で動作確認。質問の分解を試すときは2へ変更
MAX_SUBTASKS=1
MAX_CHALLENGES=2
MAX_API_CALLS=20
REQUEST_INTERVAL=3.2
SEARCH_BACKEND=lmstudio
EMBEDDING_BASE_URL=http://localhost:1234/v1
# 自分のLM StudioにあるEmbeddingモデルのIDを指定
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_BATCH_SIZE=8
# autoはnomic-embed-text-v1.5の文書/検索語プレフィックスを使う。他モデルはモデルの説明に合わせて指定
EMBEDDING_DOCUMENT_PREFIX=auto
EMBEDDING_QUERY_PREFIX=auto
# 調査のため本文も保存する。不要ならfalseへ変更する
SAVE_FULL_LOGS=true
