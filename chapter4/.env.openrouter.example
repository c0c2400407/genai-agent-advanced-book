LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# python -m workshop modelsで確認した固定ID（末尾:free）を指定
# 自動ルーターではなく、事前確認した同じモデルを参加者全員で使う
# 2026-10-29の公開APIでtools/tool_choice/structured_outputs対応を確認した候補
# 実APIでの回答品質と接続の最終確認はまだ必要
LLM_MODEL=liquid/lfm-2.5-2.6b:free
STRUCTURED_MODE=schema
TOOL_MODE=native
MAX_OUTPUT_TOKENS=1200
MAX_SUBTASKS=2
MAX_CHALLENGES=2
MAX_API_CALLS=20
REQUEST_INTERVAL=3.2
# EmbeddingもLM Studioで行う場合はlmstudioに変更し、以下のモデルをローカルでロードする
SEARCH_BACKEND=tfidf
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_MODEL=
SAVE_FULL_LOGS=true
