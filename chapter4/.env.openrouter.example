LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# 勉強会ではLM Studioを推奨。OpenRouterは任意の代替接続先
# :freeには分・日単位の上限があり、失敗した生成も日次枠に数えられる
# 最新条件: https://openrouter.ai/collections/free-models/
# python -m workshop modelsで確認した固定ID（末尾:free）を指定
# 自動ルーターではなく、事前確認した同じモデルを参加者全員で使う
# 2026-10-29にnative + schema、TF-IDF、基本質問で成功確認済み
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
STRUCTURED_MODE=schema
TOOL_MODE=native
MAX_OUTPUT_TOKENS=1200
# 初回は成功確認済みの1。質問の分解を試すときは2へ変更
MAX_SUBTASKS=1
MAX_CHALLENGES=2
MAX_API_CALLS=20
REQUEST_INTERVAL=3.2
# EmbeddingもLM Studioで行う場合はlmstudioに変更し、以下のモデルをローカルでロードする
SEARCH_BACKEND=tfidf
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_MODEL=
SAVE_FULL_LOGS=true
